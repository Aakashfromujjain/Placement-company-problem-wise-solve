import sys

def solve():
    # Read all inputs from standard input safely handling whitespace
    input_data = sys.stdin.read().split()
    if not input_data:
        return
        
    n = int(input_data[0])
    p = [int(x) for x in input_data[1:n+2]]
    
    # dp[i][j] stores the minimum energy to fuse frames from i to j
    # We use n+1 to 1-index the frames for easier mapping
    dp = [[0] * (n + 1) for _ in range(n + 1)]
    
    # L is the length of the chain we are currently evaluating
    for L in range(2, n + 1):
        for i in range(1, n - L + 2):
            j = i + L - 1
            dp[i][j] = float('inf')
            
            # Try splitting the chain at every possible position k
            for k in range(i, j):
                # Cost = cost of left segment + cost of right segment + cost to fuse them
                cost = dp[i][k] + dp[k+1][j] + (p[i-1] * p[k] * p[j])
                
                if cost < dp[i][j]:
                    dp[i][j] = cost
                    
    # The answer is the minimum cost to fuse the entire chain from frame 1 to n
    print(dp[1][n])

if __name__ == '__main__':
    solve()
